<HomeScreen>:
    BoxLayout:
        orientation: 'horizontal'
        spacing: 0
        
        Sidebar:
            id: sidebar
            main_app: app
            size_hint_x: None
            width: 0
            
        BoxLayout:
            orientation: 'vertical'
            spacing: 0
            
            BoxLayout:
                size_hint_y: None
                height: 56
                padding: [10, 5, 10, 5]
                canvas.before:
                    Color:
                        rgba: 0.314, 0.0, 1, 1
                    Rectangle:
                        pos: self.pos
                        size: self.size
                
                Button:
                    size_hint_x: None
                    width: 56
                    text: '☰'
                    background_color: 0, 0, 0, 0
                    font_size: 20
                    on_press: sidebar.toggle_menu()
                
                Label:
                    text: 'ArtikGram'
                    font_size: 20
                    bold: True
                    color: 1, 1, 1, 1
                    
                Widget:  # Spacer
                    size_hint_x: None
                    width: 56
            
            ScrollView:
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    padding: 20
                    spacing: 10
                    
                    Label:
                        text: 'Welcome to ArtikGram!'
                        font_size: 24
                        bold: True
                        size_hint_y: None
                        height: 40
                        
                    Label:
                        text: 'Your chats will appear here soon...'
                        font_size: 16
                        size_hint_y: None
                        height: 30