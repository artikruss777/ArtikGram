<HomeScreen>:
    chats_container: chats_scroll_container
    
    BoxLayout:
        orientation: 'horizontal'
        spacing: 0
        
        Sidebar:
            id: sidebar
            main_app: app
            size_hint_x: None
            width: 0
            
        BoxLayout:
            orientation: 'vertical'
            spacing: 0
            
            BoxLayout:
                size_hint_y: None
                height: 56
                padding: [10, 5, 10, 5]
                canvas.before:
                    Color:
                        rgba: 0.314, 0.0, 1, 1
                    Rectangle:
                        pos: self.pos
                        size: self.size
                
                Button:
                    size_hint_x: None
                    width: 56
                    text: '☰'
                    background_color: 0, 0, 0, 0
                    font_size: 20
                    on_press: sidebar.toggle_menu()
                
                Label:
                    text: 'ArtikGram'
                    font_size: 20
                    bold: True
                    color: 1, 1, 1, 1
                    
                Widget:
                    size_hint_x: None
                    width: 56
            
            ScrollView:
                do_scroll_x: False
                canvas.before:
                    Color:
                        rgba: 0, 0, 0, 1
                    Rectangle:
                        pos: self.pos
                        size: self.size
                
                BoxLayout:
                    id: chats_scroll_container
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    padding: 0
                    spacing: 1
                    
                    Label:
                        text: 'Loading chats...'
                        font_size: 16
                        size_hint_y: None
                        height: 40
                        color: 1, 1, 1, 1

<ChatItem>:
    canvas.before:
        Color:
            rgba: 0.1, 0.1, 0.1, 1
        Rectangle:
            pos: self.pos
            size: self.size
    
    orientation: 'horizontal'
    size_hint_y: None
    height: 70
    padding: [10, 5]
    spacing: 10
    
    BoxLayout:
        size_hint: (None, None)
        size: (50, 50)
        canvas.before:
            Color:
                rgba: 0.314, 0.0, 1, 1
            Rectangle:
                pos: self.pos
                size: self.size
        
        Label:
            text: root.avatar_text
            color: 1, 1, 1, 1
            font_size: '16sp'
            bold: True
    
    BoxLayout:
        orientation: 'vertical'
        size_hint_x: 0.8
        
        Label:
            text: root.chat_title
            size_hint_y: 0.6
            text_size: self.width, None
            halign: 'left'
            valign: 'middle'
            font_size: '14sp'
            bold: True
            color: 1, 1, 1, 1
        
        Label:
            text: root.last_message
            size_hint_y: 0.4
            text_size: self.width, None
            halign: 'left'
            valign: 'top'
            font_size: '12sp'
            color: 0.8, 0.8, 0.8, 1