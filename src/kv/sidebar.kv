<Sidebar>:
    orientation: 'vertical'
    canvas.before:
        Color:
            rgba: 0.95, 0.95, 0.95, 1
        Rectangle:
            pos: self.pos
            size: self.size
        Color:
            rgba: 0.8, 0.8, 0.8, 1
        Line:
            rectangle: self.x, self.y, self.width, self.height
    
    ScrollView:
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: self.minimum_height
            padding: 10
            spacing: 5
            Label:
                text: 'MENU'
                font_size: 16
                bold: True
                size_hint_y: None
                height: 40
                color: 0.3, 0.3, 0.3, 1
            
            Widget:
                size_hint_y: None
                height: 1
                canvas:
                    Color:
                        rgba: 0.8, 0.8, 0.8, 1
                    Rectangle:
                        pos: self.pos
                        size: self.size
            
            SidebarButton:
                text: 'Profile'
                icon: '👤'
                on_press: root.on_menu_item_click('profile')
            
            SidebarButton:
                text: 'Settings'
                icon: '⚙️'
                on_press: root.on_settings_click()
            
            Widget:
                size_hint_y: None
                height: 20
            Widget:
                size_hint_y: None
                height: 1
                canvas:
                    Color:
                        rgba: 0.8, 0.8, 0.8, 1
                    Rectangle:
                        pos: self.pos
                        size: self.size
            
            SidebarButton:
                text: 'Logout'
                icon: '🚪'
                background_color: 0.9, 0.3, 0.3, 1
                on_press: root.on_logout_click()

<SidebarButton@Button>:
    icon: ''
    size_hint_y: None
    height: 50
    background_color: 0.9, 0.9, 0.9, 1
    background_normal: ''
    background_down: ''
    canvas.before:
        Color:
            rgba: (0.85, 0.85, 0.85, 1) if self.state == 'down' else (0.9, 0.9, 0.9, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [5,]
    
    BoxLayout:
        padding: [15, 0]
        spacing: 15
        
        Label:
            text: root.icon
            size_hint_x: None
            width: 30
            font_size: 16
        
        Label:
            text: root.text
            font_size: 16
            text_size: self.width, None
            halign: 'left'
            valign: 'middle'